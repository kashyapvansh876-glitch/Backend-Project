<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <p class="main-head">Edit your Chat This : <%= Chat._id %></p>
    <br>
    <p class="main-head">This chat was Sent From <b><%= Chat.from %> to <%= Chat.to %></b> </p>
    <br>
    <form method="POST"  action="/chats/<%= Chat._id %>?_method=PUT">
        <textarea name="msg" cols="50" rows="8" class="msg-box-main"><%= Chat.msg %></textarea>
        <br>
        <br>
        <button class="edit-btn">Edit</button>
    </form>
</body>
</html>