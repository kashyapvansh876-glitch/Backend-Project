<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <h2 class="main-head">ADD NEW CHATS OF FRIENDS..</h2>
    <br>
    <form method="POST" action="/chats">
        <input type="text" placeholder="who are you" name="from" class="chat-box-main">
        <br><br>
        <textarea name="msg" class="msg-box-main">Write your massage here......</textarea>
        <br><br>
        <input type="text" placeholder="who are you sending to" name="to" class="chat-box-main">
        <br><br>
        <button class="sub-btn">Submit Msg..</button>
    </form>
</body>
</html>