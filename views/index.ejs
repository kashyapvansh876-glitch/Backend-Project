<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
<h3 class="main-head">All chats</h3>

<form method="GET" action="/chats/new">
    <button class="add-btn">Add New Massage.... </button>
</form>
<br><br>
    <% for(let chat of chats){ %>
        <div class="chat-box">
            <i><p> from: <%= chat.from %></p></i>
            <br>
        <div class="msg-box">
            <i><p><%= chat.msg %></p></i>
            <form  method="GET" action="/chats/<%=chat._id%>/edit">
               <button class="edit-btn"> Edit</button>
            </form>
            <br><br>
            <form  method="POST" action="/chats/<%=chat._id%>?_method=DELETE">
               <button class="del-btn"> Delete</button>
            </form>
        </div>
        <br>
           <i><p>Recived by: <%= chat.to %></p></i>
           <p><%= chat.created_at.toString().split(" ")[4] %></p>
           <p><%= chat.created_at.toString().split(" ").slice(0,4).join("-") %></p>
  </div>
  <br><br><br>
   <% } %>
    
</body>
</html>